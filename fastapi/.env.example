# =============================================================================
# FastAPI 环境变量（复制为 .env 后按本机修改；.env 勿提交仓库）
# 标注说明：
#   【必改】— 按本机实际情况修改，否则无法连库 / 启动异常
#   【按需】— 默认可用；要接真大模型或改端口时再改
#   【一般不用改】— 保持默认即可
# =============================================================================

# ----- 【一般不用改】服务端口 -----
PORT=8000

# ----- 数据库（导入 sql/system.sql 后的库）-----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elder_care
DB_USER=root
# 【必改】改成你本机 MySQL 的 root（或对应用户）密码
DB_PASSWORD=123456

# ----- 【一般不用改】JWT / 上传 -----
JWT_SECRET=system-jwt-secret-key-for-graduation-project-min-32-chars
JWT_EXPIRATION_MS=86400000
UPLOAD_PATH=./uploads

# ----- Agent 大模型 -----
# DeepSeek 文档：https://api-docs.deepseek.com/zh-cn/
# 【按需】true = 演示模式（无需 Key，仍会真实调用业务工具写库）
#         false = 走真实大模型（必须填写下方 LLM_API_KEY）
AGENT_DEMO_MODE=true
# 【按需】接真模型时填写；演示模式可留空
LLM_API_KEY=
# 【一般不用改】
LLM_BASE_URL=https://api.deepseek.com
# deepseek-v4-flash | deepseek-v4-pro
LLM_MODEL=deepseek-v4-flash
# Tool Calls 建议 disabled；enabled 时配合 LLM_REASONING_EFFORT=high
LLM_THINKING=disabled
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ----- 【一般不用改】知识库向量目录 -----
CHROMA_PATH=./data/chroma
KNOWLEDGE_COLLECTION=elder_care_knowledge
